# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Leave as placeholders in dev — the site runs fine without real keys and
# falls back to WhatsApp/Contact ordering when Paystack isn't configured.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder

# WhatsApp business number, international format, digits only (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=233244093227

# Business info — shown in footer, contact page, and page metadata
NEXT_PUBLIC_BUSINESS_NAME="Veroin Snacks LTD"
NEXT_PUBLIC_BUSINESS_EMAIL=hello@veroinsnacks.com
NEXT_PUBLIC_BUSINESS_PHONE="+233 24 000 0000"
NEXT_PUBLIC_BUSINESS_ADDRESS="Accra, Ghana"

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
